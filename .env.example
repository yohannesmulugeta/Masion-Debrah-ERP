# Maison Debrah ERP Configuration
# Copy into .env.live.local for local live mode. This file is ignored by Git.
# Use the project's publishable browser key only. Never put a secret or service-role key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Use live only with an approved project URL, publishable key, Auth, and staff profiles.
# The default build remains the browser-local public demo.
VITE_ERP_MODE=live

# ERP App Branding
VITE_APP_TITLE="Maison Debrah ERP | Ethiopia Operations"
