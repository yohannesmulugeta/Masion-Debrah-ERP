# Maison Debrah ERP Configuration
# Reserved for future integration with an approved Supabase project.
# The current UI does not connect its workflows to Supabase.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Demo workflows use browser-local storage. Changing this flag does not make the UI live.
VITE_ERP_MODE=demo

# ERP App Branding
VITE_APP_TITLE="Maison Debrah ERP | Ethiopia Operations"
